<!doctype html><html lang="en"><head><meta name="benchmark-presentation" content="opus5-october23-1342"><meta name="benchmark-cohort" content="october19-consolidated-1342"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>System1 decisions:31 routes,1342 questions</title><style>body{margin:0;color:#183044;background:#f5f8fa;font:16px/1.6 system-ui,-apple-system,sans-serif}main{max-width:1480px;margin:auto;padding:28px 32px 70px}header{background:#142f43;color:white;padding:38px 32px}header>div{max-width:1480px;margin:auto}h1{font-size:2.4rem;line-height:1.2;margin:.3em 0}h2{font-size:1.65rem;line-height:1.3;margin-top:1.3em}h3{font-size:1.1rem;margin-bottom:.2em}p{max-width:1150px}a{color:#006a85}header a{color:#c6f0ff}nav{display:flex;gap:22px;flex-wrap:wrap;margin-top:20px}.meta{color:#c1d5df}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:24px 0}.card{background:white;border:1px solid #d8e4eb;border-radius:10px;padding:18px}.big{font-size:1.7rem;font-weight:700}.label{font-size:.9rem;color:#51697c}.figure{background:white;border:1px solid #dce5eb;border-radius:10px;overflow:hidden;margin:24px 0}.figure img{width:100%;height:auto;display:block}.caption{font-size:.9rem;padding:10px 20px;color:#4c6475}.scroll{overflow:auto;background:white;border:1px solid #dce5eb;border-radius:8px;margin:20px 0;max-height:850px}table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:right;padding:10px 12px;border-bottom:1px solid #e3e9ee;white-space:nowrap}th{position:sticky;top:0;background:#eaf1f5;z-index:1}td:nth-child(2),th:nth-child(2){text-align:left}td:first-child,th:first-child{text-align:left}tr:hover{background:#f1f6f8}.metric{padding:4px 7px;border-radius:4px;display:inline-block;font-weight:600;white-space:nowrap}.b0{background:#d8f1e8}.b1{background:#fff4c2}.b2{background:#ffe4ca}.b3{background:#fbdedd}.incomplete{border-bottom:2px dotted #9a6700}.legend{display:flex;gap:8px;flex-wrap:wrap;font-size:.9rem}.note{padding:16px 20px;background:#fff5df;border-left:4px solid #bc8a2e}.domain-definitions table td{white-space:normal;min-width:95px;vertical-align:top}.domain-definitions table td:nth-child(3),.domain-definitions table td:nth-child(4){min-width:240px;text-align:left}.domain-definitions table td:nth-child(6){min-width:190px;text-align:left}details{background:white;border:1px solid #dce5eb;border-radius:8px;padding:18px 22px;margin:20px 0}summary{font-weight:700;cursor:pointer}.downloads{display:flex;gap:20px;flex-wrap:wrap}.small{font-size:.9rem;color:#52687a}footer{margin-top:40px;border-top:1px solid #dce5eb;padding-top:18px}@media(max-width:800px){main{padding:20px 12px 50px}header{padding:26px 18px}h1{font-size:1.8rem}.cards{grid-template-columns:repeat(2,1fr)}.card{padding:12px}th,td{padding:8px;font-size:12px}}
main{max-width:1280px}.category-section{margin:44px 0 60px;scroll-margin-top:20px}.category-section>h3{font-size:1.65rem;margin-bottom:10px}.category-nav{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px, 1fr));gap:12px;margin:20px 0}.category-nav a{background:white;border:1px solid #cbdce5;padding:16px;border-radius:8px;line-height:1.4}.category-guide{background:#e9f2f6;padding:20px 24px;border-radius:8px}.category-guide li{margin:8px 0}.accuracy-legend{display:flex;gap:6px;flex-wrap:wrap;margin:16px 0}.accuracy-legend span{padding:6px 13px;border:1px solid #bacbd4;border-radius:4px}.category-matrix{overflow:auto;max-height:950px;border:1px solid #b7ccd8;border-radius:8px;background:white;margin:24px 0;isolation:isolate}.category-matrix table{width:100%;table-layout:fixed;font-size:16px;min-width:930px}.category-matrix th,.category-matrix td{padding:13px 10px;white-space:normal;text-align:center;vertical-align:middle}.category-matrix thead th{top:0;background:#e8f0f5;z-index:3;line-height:1.4;font-weight:650}.category-matrix thead small{display:block;font-size:13px;margin-top:8px;color:#405b6d}.category-matrix th:first-child{position:sticky;left:0;width:230px;text-align:left;background:#f0f5f8;z-index:2;border-right:2px solid #b7ccd8;overflow-wrap:anywhere}.category-matrix thead th:first-child{z-index:4}.category-matrix tbody th{font-weight:600;font-size:15px}.category-matrix td strong,.category-matrix td span{display:block}.category-matrix td strong{font-size:18px}.category-matrix td span{font-size:14px;margin-top:3px}.category-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:25px 0}.category-card{background:white;border:1px solid #cedee8;border-top:4px solid #307d9c;border-radius:8px;padding:20px;scroll-margin-top:20px;min-width:0}.category-card h4{font-size:1.15rem;margin:0 0 8px}.category-card p{margin:10px 0}.category-meta{color:#536b7e;font-size:.9rem}.example{background:#f2f6f8;padding:12px;border-radius:4px}.category-card details{padding:12px;margin:15px 0 0}.ranked-category{overflow:auto}.ranked-category table{font-size:14px}.ranked-category th{white-space:normal;position:static}.ranked-category td{white-space:nowrap}.category-chart img{width:100%;max-width:1000px;display:block;margin:auto}.category-section>details{padding:14px 20px}.category-section>details summary{margin-bottom:10px}.category-section>p{max-width:1050px}@media(max-width:700px){.category-cards{grid-template-columns:1fr}.category-guide{padding:15px}.category-matrix th:first-child{width:170px}.category-matrix table{min-width:900px}.category-matrix tbody th{font-size:14px}.category-nav{grid-template-columns:1fr}.category-section>h3{font-size:1.35rem}.category-card{padding:16px}.category-section{margin:32px 0}.category-chart{overflow:auto}.category-chart img{min-width:830px}}
.llm-reference>th{background:#fff6d5}.native-addition>th{border-left:4px solid #1684ac}.free-note{background:#edf1f5;padding:16px;border-radius:6px}.addition-note{background:#eaf5fb;padding:20px;border-radius:8px}.cost-incomplete{text-decoration:underline;text-decoration-color:#b7770b;text-underline-offset:4px}</style></head><body><main><h1>System 1 Decision Benchmark</h1><p>27 specialized decision models and 4 no-reasoning LLM references. Same 1,342 text questions,31 categories. Updated October 23, 2026.</p><nav><a href="#overview">Overall results</a><a href="#new-additions">Opus 5 findings</a><a href="#llm-references">LLM references</a><a href="#functions">Named categories</a><a href="#method">Method</a></nav><div class="cards"><div class="card"><div class="label">Highest observed text score</div><div class="big">86.0%</div><div class="small">Fastino GLiDE ·1154/1342</div></div><div class="card"><div class="label">Highest LLM reference</div><div class="big">85.2%</div><div class="small">GPT-6 Sol, reasoning off ·1143/1342</div></div><div class="card"><div class="label">New Opus 5 reference</div><div class="big">82.6%</div><div class="small">1109/1342 ·1538 ms median</div></div><div class="card"><div class="label">Matched question coverage</div><div class="big">31 routes</div><div class="small">41,602 first attempts ·31 categories</div></div></div><section id="overview"><h2>Accuracy, speed and cost: all 31 routes</h2><p>Blue bars: decision models. Pale yellow: no-reasoning LLM references. Every row covers 1,342 first attempts. + ? means missing charges; Opus has 35. ~ marks Fastino’s usage-based tariff calculation.</p><div class="figure"><a href="opus5_reference_2026-10-23/accuracy_speed_cost.svg"><img src="opus5_reference_2026-10-23/accuracy_speed_cost.png" alt="31 routes: accuracy, speed and cost; Opus5 is a pale-yellow LLM reference"></a></div><div class="scroll"><table><thead><tr><th>Model</th><th>Type</th><th>Correct / questions</th><th>Median</th><th>p95</th><th>Cost per 1000</th><th>Actual 1342-question cost</th></tr></thead><tbody><tr class="" data-summary-model="fastino_glide"><th scope="row">Fastino GLiDE</th><td>Decision model</td><td>1154/1342<br>86.0%</td><td style="background:#d8f1e8">213 ms</td><td style="background:#ffe4ca">802 ms</td><td style="background:#fff4c2">~$0.012960</td><td>~$0.017392</td></tr><tr class="llm-reference" data-summary-model="reference_sol"><th scope="row">GPT-6 Sol — no reasoning</th><td>LLM reference</td><td>1143/1342<br>85.2%</td><td style="background:#fbdedd">1023 ms</td><td style="background:#fbdedd">1546 ms</td><td style="background:#fbdedd">$0.632112</td><td>$0.848294</td></tr><tr class="" data-summary-model="mammoth1"><th scope="row">Mammoth-1</th><td>Decision model</td><td>1139/1342<br>84.9%</td><td style="background:#d8f1e8">240 ms</td><td style="background:#ffe4ca">666 ms</td><td style="background:#edf1f5">Promotional free access*</td><td>Promotional free access*</td></tr><tr class="" data-summary-model="drex_max"><th scope="row">Drex Max</th><td>Decision model</td><td>1127/1342<br>84.0%</td><td style="background:#fff4c2">286 ms</td><td style="background:#fff4c2">445 ms</td><td style="background:#fff4c2">$0.021180</td><td>$0.028423</td></tr><tr class="" data-summary-model="respan02"><th scope="row">Respan Span-02</th><td>Decision model</td><td>1127/1342<br>84.0%</td><td style="background:#d8f1e8">206 ms</td><td style="background:#fbdedd">2157 ms</td><td style="background:#d8f1e8">$0.003537</td><td>$0.004746</td></tr><tr class="" data-summary-model="pplx_decider12"><th scope="row">Perplexity Decider v1.2</th><td>Decision model</td><td>1120/1342<br>83.5%</td><td style="background:#d8f1e8">249 ms</td><td style="background:#fff4c2">332 ms</td><td style="background:#d8f1e8">$0.007000 + ?</td><td>$0.009394 + ?</td></tr><tr class="" data-summary-model="nimble_v4_max"><th scope="row">Nimble v4 Max</th><td>Decision model</td><td>1115/1342<br>83.1%</td><td style="background:#d8f1e8">235 ms</td><td style="background:#fff4c2">329 ms</td><td style="background:#ffe4ca">$0.027633</td><td>~$0.037084</td></tr><tr class="llm-reference" data-summary-model="reference_opus5"><th scope="row">Opus 5 — no thinking, JSON-choice</th><td>LLM reference</td><td>1109/1342<br>82.6%</td><td style="background:#fbdedd">1538 ms</td><td style="background:#fbdedd">2109 ms</td><td style="background:#fbdedd">$3.458320 + ?</td><td>$4.641065 + ?</td></tr><tr class="" data-summary-model="d3_turbo"><th scope="row">d3-turbo</th><td>Decision model</td><td>1106/1342<br>82.4%</td><td style="background:#d8f1e8">165 ms</td><td style="background:#fff4c2">298 ms</td><td style="background:#edf1f5">Free public access*</td><td>Free public access*</td></tr><tr class="" data-summary-model="liquid_ultra"><th scope="row">Liquid d1-ultra</th><td>Decision model</td><td>1084/1342<br>80.8%</td><td style="background:#d8f1e8">200 ms</td><td style="background:#fff4c2">393 ms</td><td style="background:#fff4c2">$0.012124 + ?</td><td>$0.016270 + ?</td></tr><tr class="" data-summary-model="amos_large"><th scope="row">Amos 1 Large</th><td>Decision model</td><td>1074/1342<br>80.0%</td><td style="background:#fff4c2">311 ms</td><td style="background:#fff4c2">360 ms</td><td style="background:#edf1f5">Free public access*</td><td>Free public access*</td></tr><tr class="llm-reference" data-summary-model="reference_sonnet"><th scope="row">Sonnet 5.5 — no thinking, JSON-choice</th><td>LLM reference</td><td>1070/1342<br>79.7%</td><td style="background:#fbdedd">1506 ms</td><td style="background:#fbdedd">2424 ms</td><td style="background:#fbdedd">$1.433613</td><td>$1.923908</td></tr><tr class="" data-summary-model="kettei_fat"><th scope="row">kettei-fat</th><td>Decision model</td><td>1066/1342<br>79.4%</td><td style="background:#d8f1e8">174 ms</td><td style="background:#d8f1e8">214 ms</td><td style="background:#fff4c2">$0.015433</td><td>$0.020711</td></tr><tr class="" data-summary-model="jev114"><th scope="row">Jev 1.14</th><td>Decision model</td><td>1030/1342<br>76.8%</td><td style="background:#d8f1e8">179 ms</td><td style="background:#fff4c2">269 ms</td><td style="background:#fff4c2">$0.024571</td><td>$0.032974</td></tr><tr class="" data-summary-model="jev113"><th scope="row">Jev 1.13</th><td>Decision model</td><td>1026/1342<br>76.5%</td><td style="background:#d8f1e8">189 ms</td><td style="background:#fff4c2">323 ms</td><td style="background:#fff4c2">$0.024571</td><td>$0.032974</td></tr><tr class="" data-summary-model="mercury_decide"><th scope="row">Mercury Decide</th><td>Decision model</td><td>1017/1342<br>75.8%</td><td style="background:#d8f1e8">238 ms</td><td style="background:#fff4c2">388 ms</td><td style="background:#d8f1e8">$0.006956</td><td>$0.009334</td></tr><tr class="" data-summary-model="elephant1"><th scope="row">Elephant-1</th><td>Decision model</td><td>1004/1342<br>74.8%</td><td style="background:#d8f1e8">139 ms</td><td style="background:#fff4c2">272 ms</td><td style="background:#edf1f5">Promotional free access*</td><td>Promotional free access*</td></tr><tr class="llm-reference" data-summary-model="reference_qwen"><th scope="row">Qwen3.8-Max — none, Hyper Charm</th><td>LLM reference</td><td>967/1342<br>72.1%</td><td style="background:#fbdedd">1191 ms</td><td style="background:#fbdedd">1731 ms</td><td style="background:#fbdedd">$0.614821 + ?</td><td>$0.825090 + ? quota</td></tr><tr class="" data-summary-model="liquid_d1"><th scope="row">Liquid d1</th><td>Decision model</td><td>965/1342<br>71.9%</td><td style="background:#d8f1e8">206 ms</td><td style="background:#ffe4ca">827 ms</td><td style="background:#d8f1e8">$0.005773</td><td>$0.007748</td></tr><tr class="" data-summary-model="clef"><th scope="row">Cloudflare Clef</th><td>Decision model</td><td>936/1342<br>69.7%</td><td style="background:#fff4c2">268 ms</td><td style="background:#fff4c2">417 ms</td><td style="background:#fff4c2">$0.017594</td><td>$0.023611</td></tr><tr class="" data-summary-model="pplx_flash12"><th scope="row">Perplexity Decider Flash v1.2</th><td>Decision model</td><td>923/1342<br>68.8%</td><td style="background:#d8f1e8">159 ms</td><td style="background:#d8f1e8">231 ms</td><td style="background:#d8f1e8">$0.003406 + ?</td><td>$0.004570 + ?</td></tr><tr class="" data-summary-model="microsoft_decision"><th scope="row">Microsoft-Decision-1</th><td>Decision model</td><td>921/1342<br>68.6%</td><td style="background:#fff4c2">283 ms</td><td style="background:#ffe4ca">566 ms</td><td style="background:#fff4c2">$0.012237</td><td>$0.016422</td></tr><tr class="" data-summary-model="drex20"><th scope="row">Drex v2.0</th><td>Decision model</td><td>915/1342<br>68.2%</td><td style="background:#d8f1e8">232 ms</td><td style="background:#ffe4ca">755 ms</td><td style="background:#fff4c2">$0.016661 + ?</td><td>$0.022359 + ?</td></tr><tr class="" data-summary-model="clef_flash"><th scope="row">Cloudflare Clef Flash</th><td>Decision model</td><td>860/1342<br>64.1%</td><td style="background:#d8f1e8">245 ms</td><td style="background:#fff4c2">353 ms</td><td style="background:#d8f1e8">$0.008797</td><td>$0.011806</td></tr><tr class="" data-summary-model="clef_omni"><th scope="row">Cloudflare Clef Omni</th><td>Decision model</td><td>860/1342<br>64.1%</td><td style="background:#d8f1e8">241 ms</td><td style="background:#fff4c2">400 ms</td><td style="background:#fbdedd">$0.061511 + ?</td><td>$0.082547 + ?</td></tr><tr class="" data-summary-model="drex15"><th scope="row">Drex v1.5</th><td>Decision model</td><td>853/1342<br>63.6%</td><td style="background:#d8f1e8">203 ms</td><td style="background:#ffe4ca">649 ms</td><td style="background:#fff4c2">$0.011160</td><td>$0.014976</td></tr><tr class="" data-summary-model="kev4b"><th scope="row">Kev 4B</th><td>Decision model</td><td>822/1342<br>61.3%</td><td style="background:#d8f1e8">225 ms</td><td style="background:#fff4c2">377 ms</td><td style="background:#fff4c2">$0.011718</td><td>$0.015725</td></tr><tr class="" data-summary-model="luna_decisions"><th scope="row">Luna 6 Decisions</th><td>Decision model</td><td>758/1342<br>56.5%</td><td style="background:#fff4c2">254 ms</td><td style="background:#ffe4ca">527 ms</td><td style="background:#ffe4ca">$0.035840 + ?</td><td>$0.048097 + ?</td></tr><tr class="" data-summary-model="tev1_4b_native"><th scope="row">Tev1 4B experimental (OpenRouter native adapter)</th><td>Decision model</td><td>751/1342<br>56.0%</td><td style="background:#d8f1e8">198 ms</td><td style="background:#fff4c2">253 ms</td><td style="background:#fff4c2">$0.015657</td><td>$0.021011</td></tr><tr class="" data-summary-model="classify1"><th scope="row">ScaleDown Classify-1</th><td>Decision model</td><td>550/1342<br>41.0%</td><td style="background:#fff4c2">268 ms</td><td style="background:#fff4c2">362 ms</td><td style="background:#fff4c2">$0.021388</td><td>$0.028703</td></tr><tr class="" data-summary-model="solar_flash"><th scope="row">Solar Decide Flash</th><td>Decision model</td><td>538/1342<br>40.1%</td><td style="background:#ffe4ca">540 ms</td><td style="background:#ffe4ca">747 ms</td><td style="background:#ffe4ca">$0.030203 + ?</td><td>$0.040532 + ?</td></tr></tbody></table></div><details><summary>Fixed speed and cost color bands</summary><table><thead><tr><th>Band</th><th>Response time</th><th>Known cost per 1,000</th></tr></thead><tbody><tr><th style="background:#d8f1e8">Green</th><td>≤250 ms</td><td>≤$0.010</td></tr><tr><th style="background:#fff4c2">Yellow</th><td>>250–500 ms</td><td>>$0.010–0.025</td></tr><tr><th style="background:#ffe4ca">Orange</th><td>>500–1,000 ms</td><td>>$0.025–0.050</td></tr><tr><th style="background:#fbdedd">Red</th><td>>1,000 ms</td><td>>$0.050</td></tr></tbody></table><p>Thresholds use unrounded values. Incomplete costs describe a known lower bound. The median, not p95, is the speed-screening measure.</p></details></section><section id="new-additions"><h2>October 23: Opus 5 without thinking</h2><h3>Opus 5 without thinking scored 82.6%, below Sol and above Sonnet</h3><p>Opus 5 answered1109/1342 correctly (82.6%), versus GPT-6 Sol without reasoning at 1143 (85.2%) and Sonnet 5.5 in constrained JSON-choice mode at 1070 (79.7%). Fastino GLiDE remains highest at 1154 (86.0%); Mammoth scored1139 (84.9%) and Span and Drex Max 1127 each (84.0%). These are observed results on the same developing bank, not a general intelligence ranking.</p><h3>Near-perfect unique assignments, with weaker exceptions and causal changes</h3><p>Opus scored 66/67 on one-to-one assignments: giving every person or object exactly one partner while satisfying all clues. Sol scored 61/67, Fastino 63/67 and Drex Max 65/67. Opus scored 47/74 on truth-tellers and liars, versus Sol 38/74 and Fastino 59/74. It answered all 52 rule-violation questions correctly. On exceptions and priority rules, Opus scored 43/58 and Sol 57/58; on changing a cause while holding other inputs fixed, Opus scored35/50 and Sol 44/50. Ordered procedures remained18/48, the same as Sol and Fastino, versus Span 33/48.</p><h3>The larger LLM cost did not buy a higher overall System 1 score</h3><p>Opus’s mean/median/p95 response was 1581/1538/2109 ms. Its API-reported bank cost was $4.641065 plus unreported charges for 35 responses, or at least $3.458320 per 1000 questions. Sol’s total was $0.84829450 and Sonnet’s $1.923908. The known Opus amount alone is 5.5 times Sol’s and 2.4 times Sonnet’s. Fastino’s separately labelled usage-based estimate was $0.01739196, with a 213 ms median. Different dates, providers and loads limit timing and price comparisons; missing charges are not zero.</p><h3>A constrained answer format, with 37 refusals retained as unsuccessful</h3><p>The full Opus run used thinking.type=disabled, output_config.effort=high, no tools and a 16-token cap through OpenRouter’s pinned Anthropic standard route. All 1305 usable JSON choices explicitly reported zero thinking tokens and no thinking blocks. There were 37 refusals: two reported zero thinking tokens, while 35 omitted thinking/cost telemetry. All 37 remain unsuccessful first attempts in the 1342-question score. There were no retries or malformed JSON choices. A separate eight-question bare-ID trial produced five usable IDs, two malformed/explanatory outputs and one refusal; it is not pooled into this score. Constraining the answer grammar does not make this identical to unconstrained bare-ID delivery.</p><h3>The harder additions separate the references too</h3><p>Opus scored1001/1136 (88.1%) on the original portion and108/206 (52.4%) on the additions. Across the six newest eight-question categories it scored 29/48, versus Sol 36/48, Span 34/48 and Fastino 29/48. The primary score remains one unweighted1342-question total. Existing questions, category weights and all 30 earlier model records are unchanged.</p><h3>Fastino has the highest observed text score, not the highest image score</h3><p>Fastino GLiDE answered1154/1342 correctly (86.0%), ahead of GPT-6 Sol without reasoning at 1143 (85.2%), Mammoth-1 at 1139 (84.9%), and Span-02 and Drex Max at 1127 each (84.0%). The gaps are 11 and15 answers against Sol and Mammoth. These scores describe this developing bank and do not establish a reliable universal intelligence ordering. On the separate image bank, GLiDE scored158/200 (79.0%): second, one answer behind Amos at 159/200. Text and image percentages are not combined.</p><h3>A short response time and a metered price below the Sol reference</h3><p>GLiDE’s mean / median / p95 text response was 343/213/802 ms. Sol’s median was 1023 ms: 4.8 times GLiDE’s measured median. GLiDE’s usage-based cost was $0.01739196 for the complete bank, or $0.01296 per 1000 questions; Sol’s API-reported total was $0.84829450, about 48.8 times as much. Span’s median was slightly shorter at 206 ms, and its recorded cost was lower at $0.00474628. GLiDE is not the cheapest or fastest entry. These are different dated routes, not controlled hardware measurements. Fastino cost is calculated from reported input tokens and the captured tariff, not a returned monetary receipt.</p><h3>Truth-tellers separate GLiDE from the nearby leaders</h3><p>GLiDE scored 59/74 on truth-tellers and liars: deciding which assignments of truth and falsehood make all the supplied statements consistent. Span scored 55/74, Mammoth 48/74 and Sol 38/74. On exact truth counting—how many supplied claims are true—GLiDE scored 45/71, versus Span 46/71 and Sol 51/71. These are distinct operations: being better at assigning truth-tellers does not make GLiDE best at counting true claims.</p><h3>Strong rules and evidence, with a specific state-update weakness</h3><p>GLiDE answered all 52 rule-counterexample questions correctly, 51/52 required-condition questions, 45/46 if-then questions and 41/42 interval comparisons. Required-condition questions ask whether every prerequisite holds; counterexamples ask which case breaks a stated rule. Its one-to-one assignments score was 63/67, versus Mammoth’s 64/67 and Drex Max’s 65/67. Ordered procedures remained18/48 (37.5%), the same as Mammoth and Sol and below Span’s 33/48. Those questions require applying each edit to the current state in order, not recognizing a plausible end state. Tracking swaps gave GLiDE 31/52.</p><h3>The new categories do not follow the overall ranking</h3><p>Across the six eight-question categories covering risk, information value, worst-case choice, strategic response, concurrent operations and information leaks, GLiDE scored 29/48. Sol scored36/48, Span 34/48 and Mammoth 30/48. GLiDE scored3/8 on whether extra information is worth paying for, and 4/8 on worst-case choices without supplied probabilities; Span scored 8/8 on the latter. Each category has only eight questions, so one answer changes its score by 12.5 percentage points. The category profiles identify different useful routes rather than one uniformly best model.</p><h3>The harder additions remain harder for GLiDE</h3><p>GLiDE scored1028/1136 (90.5%) on the original portion and126/206 (61.2%) on the additions. These are descriptive slices of the same unweighted1342-question score, not separate leaderboards. All existing questions, options, audits and category weights are unchanged. No older model was rerun or re-scored for this addition.</p><h3>The served version and image support were checked, not assumed</h3><p>The request model is fastino/GLiDE. The authenticated live catalog described a one-pass GLiDE v2.2 deployment; every scored response identified glide_v2. This is a hosted alias, not an immutable-weight attestation, and it must not be labelled v1.2. The catalog image flag was false while the documentation described image parts; real single-image and three-image probes succeeded, followed by the full 200-image run. No OCR or captions replaced pixels. All 1542 scored calls returned usable typed decisions, with no retries, valid probability distributions, zero reported output tokens and not-stored retention headers. That telemetry does not independently reveal undisclosed internal computation.</p><h3>Earlier model profiles and price qualifications remain available</h3><p>Mammoth remains the next-highest specialized text model at 1139/1342. Drex Max and Span tie at 1127, but Drex’s one-to-one assignments score is 65/67 and Span’s procedure score is 33/48. Elephant’s 1004/1342 remains below Jev 1.14’s 1030/1342. Baseten’s captured promotional free access and Amos/d3 public-free access are not API-reported metered prices of zero. The 29 earlier model records and their dated release seals are preserved exactly; their tests were not repeated to create this update.</p></section><section id="llm-references"><h2>Selected LLM references, reasoning off</h2><p>These four routes provide context for immediate decision performance, not an exhaustive LLM ranking. Sol uses explicit reasoning off. Sonnet and Opus use separately constrained JSON-choice grammars after stopped bare-ID trials; those trials are not pooled. Opus uses disabled thinking, high effort and no tools. All usable Opus answers explicitly report zero thinking tokens; 35 refusals omit telemetry. Qwen uses none, but unreported reasoning counts are not called zero. Failures remain unsuccessful first deliveries.</p></section><section id="functions"><h2>Category scores: what each task means</h2><p>All 31 categories are arranged into five reading groups. These groups organize the display only; they do not change the benchmark, its weighting or any score.</p><div class="category-guide"><h3>How to read these results</h3><ul><li>Read a row to compare one model across the named tasks. Read a column to compare models on one task.</li><li>Each cell gives <b>correct answers / questions</b>, followed by the percentage. For example, <b>6/8 · 75%</b> means six correct first decisions out of eight, not a confidence rating.</li><li>Darker blue means higher accuracy on the same fixed 0-100% scale throughout. Random guessing among five choices averages 20%. Percentages help compare differently sized categories; counts show the size of the evidence.</li><li>The model names stay visible when you scroll sideways. On a narrow screen, each explanation card also has an <b>All 31 routes</b> list with no wide matrix to decode.</li><li>Small categories are coarse: one answer changes an eight-question category by 12.5 percentage points. A perfect sampled score is not a reliability guarantee.</li></ul></div><nav class="category-nav" aria-label="Category groups"><a href="#group-rules">Rules and evidence<small> · 6 categories</small></a><a href="#group-ordering">Ordering, schedules and assignments<small> · 5 categories</small></a><a href="#group-state">Claims, changing state and perspectives<small> · 7 categories</small></a><a href="#group-causes">Causes, plans and exceptions<small> · 7 categories</small></a><a href="#group-uncertainty">Risk, strategy and system behavior<small> · 6 categories</small></a></nav><div class="accuracy-legend" aria-label="Fixed accuracy color scale"><span style="background:#ffffd9;color:#000000">0%</span><span style="background:#d6efb3;color:#000000">20%</span><span style="background:#73c8bd;color:#000000">40%</span><span style="background:#2498c1;color:#000000">60%</span><span style="background:#234da0;color:#ffffff">80%</span><span style="background:#081d58;color:#ffffff">100%</span></div><section class="category-section" id="group-rules"><h3>Rules and evidence</h3><p>Which facts meet a rule, which conclusions follow, and when is the evidence insufficient?</p><div class="category-matrix" tabindex="0" role="region" aria-label="Category scores; scroll horizontally on narrow screens"><table><thead><tr><th scope="col">Model</th><th scope="col"><a href="#category-F01">Lookup and filtering</a><small>43 questions</small></th><th scope="col"><a href="#category-F02">Following if-then rules</a><small>46 questions</small></th><th scope="col"><a href="#category-F03">Checking required conditions</a><small>52 questions</small></th><th scope="col"><a href="#category-F04">Combining AND, OR and NOT</a><small>54 questions</small></th><th scope="col"><a href="#category-F05">All, some, none and sets</a><small>49 questions</small></th><th scope="col"><a href="#category-F11">Enough evidence or a conflict?</a><small>41 questions</small></th></tr></thead><tbody><tr><th scope="row">Fastino GLiDE</th><td data-model="fastino_glide" data-category="F01" data-correct="41" data-n="43" style="background:#12256d;color:#ffffff"><strong>41/43</strong><span>95.3%</span></td><td data-model="fastino_glide" data-category="F02" data-correct="45" data-n="46" style="background:#0d2161;color:#ffffff"><strong>45/46</strong><span>97.8%</span></td><td data-model="fastino_glide" data-category="F03" data-correct="51" data-n="52" style="background:#0c2060;color:#ffffff"><strong>51/52</strong><span>98.1%</span></td><td data-model="fastino_glide" data-category="F04" data-correct="51" data-n="54" style="background:#152772;color:#ffffff"><strong>51/54</strong><sp