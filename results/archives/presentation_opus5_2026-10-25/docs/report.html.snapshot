y="F04" data-correct="50" data-n="54" style="background:#182a7a;color:#ffffff"><strong>50/54</strong><span>92.6%</span></td><td data-model="respan02" data-category="F05" data-correct="43" data-n="49" style="background:#243392;color:#ffffff"><strong>43/49</strong><span>87.8%</span></td><td data-model="respan02" data-category="F11" data-correct="36" data-n="41" style="background:#243392;color:#ffffff"><strong>36/41</strong><span>87.8%</span></td></tr><tr><th scope="row">Perplexity Decider v1.2</th><td data-model="pplx_decider12" data-category="F01" data-correct="40" data-n="43" style="background:#172978;color:#ffffff"><strong>40/43</strong><span>93.0%</span></td><td data-model="pplx_decider12" data-category="F02" data-correct="45" data-n="46" style="background:#0d2161;color:#ffffff"><strong>45/46</strong><span>97.8%</span></td><td data-model="pplx_decider12" data-category="F03" data-correct="50" data-n="52" style="background:#102369;color:#ffffff"><strong>50/52</strong><span>96.2%</span></td><td data-model="pplx_decider12" data-category="F04" data-correct="48" data-n="54" style="background:#21318d;color:#ffffff"><strong>48/54</strong><span>88.9%</span></td><td data-model="pplx_decider12" data-category="F05" data-correct="44" data-n="49" style="background:#203089;color:#ffffff"><strong>44/49</strong><span>89.8%</span></td><td data-model="pplx_decider12" data-category="F11" data-correct="37" data-n="41" style="background:#1e2e85;color:#ffffff"><strong>37/41</strong><span>90.2%</span></td></tr><tr><th scope="row">Nimble v4 Max</th><td data-model="nimble_v4_max" data-category="F01" data-correct="41" data-n="43" style="background:#12256d;color:#ffffff"><strong>41/43</strong><span>95.3%</span></td><td data-model="nimble_v4_max" data-category="F02" data-correct="45" data-n="46" style="background:#0d2161;color:#ffffff"><strong>45/46</strong><span>97.8%</span></td><td data-model="nimble_v4_max" data-category="F03" data-correct="49" data-n="52" style="background:#152772;color:#